{
 "format": "eleckoi.regex-rules-export",
 "version": 2,
 "rules": [
  {
   "id": "phone-render",
   "name": "外置手机 · 界面渲染",
   "pattern": "/<Phone>[\\s\\S]*?<\\/Phone>/",
   "replacement": "<%\n const __m = /<Phone>([\\s\\S]*?)<\\/Phone>/i.exec(rawContent);\n const src = __m ? __m[1] : rawContent;\n%><!doctype html>\n<html lang=\"zh-CN\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"eleckoi-author-api\" content=\"0.1.0\">\n<style>\n:root{--bg:#0f1115;--panel:#171a21;--me:#95ec69;--other:#2a2f3a;--text:#e6e8ec;--sub:#8b93a3;--line:#242a35;--accent:#5b8cff}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nbody{margin:0;padding:0;background:transparent;font:14px/1.5 -apple-system,\"PingFang SC\",\"Noto Sans SC\",sans-serif;color:var(--text)}\n.wrap{padding:8px}\n.phone{background:var(--bg);border-radius:16px;overflow:hidden;border:1px solid var(--line);box-shadow:0 6px 24px rgba(0,0,0,.35)}\n.tabs{display:flex;gap:0;background:var(--panel);border-bottom:1px solid var(--line);overflow-x:auto;scrollbar-width:none}\n.tabs::-webkit-scrollbar{display:none}\n.tab{flex:0 0 auto;padding:10px 14px;font-size:13px;color:var(--sub);cursor:pointer;border-bottom:2px solid transparent;white-space:nowrap}\n.tab.on{color:#fff;border-bottom-color:var(--accent);font-weight:600}\n.tab .dot{display:inline-block;min-width:16px;height:16px;line-height:16px;padding:0 4px;margin-left:5px;border-radius:8px;background:#ff4d4f;color:#fff;font-size:10px;text-align:center;vertical-align:1px}\n.pane{display:none;padding:12px}\n.pane.on{display:block}\n.head{font-size:12px;color:var(--sub);margin:0 0 10px;display:flex;justify-content:space-between;align-items:center}\n.msg{display:flex;gap:8px;margin-bottom:12px;align-items:flex-start}\n.ava{flex:0 0 32px;width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,#4a6cf7,#7b4af7);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#fff;overflow:hidden}\n.ava img{width:100%;height:100%;object-fit:cover}\n.body{flex:1;min-width:0}\n.name{font-size:11px;color:var(--sub);margin-bottom:3px}\n.bubble{display:inline-block;max-width:100%;padding:8px 11px;border-radius:10px;background:var(--other);word-break:break-word;white-space:pre-wrap}\n.bubble.voice{display:inline-flex;align-items:center;gap:6px;color:#cfe0ff}\n.bubble.voice .dur{font-size:11px;color:var(--sub)}\n.redenv{display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border-radius:10px;background:linear-gradient(135deg,#e8543f,#f0854a);color:#fff;font-weight:600}\n.redenv small{font-weight:400;opacity:.85;font-size:11px}\n.sticker{max-width:130px;border-radius:8px;display:block;background:#1c2028}\n.time{text-align:center;font-size:11px;color:#5b6373;margin:10px 0}\n.moment{background:var(--panel);border-radius:12px;padding:12px;margin-bottom:12px;border:1px solid var(--line)}\n.mhead{display:flex;gap:8px;align-items:center;margin-bottom:8px}\n.mtext{white-space:pre-wrap;word-break:break-word}\n.mmeta{font-size:11px;color:#5b6373;margin-top:6px}\n.replies{margin-top:8px;border-top:1px solid var(--line);padding-top:8px}\n.reply{font-size:12.5px;color:#c3c9d6;padding:2px 0}\n.reply b{color:var(--accent);font-weight:600}\n.empty{color:#5b6373;font-size:13px;text-align:center;padding:24px 0}\n.livebox{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:12px}\n.livenum{font-size:12px;color:#ff7a7a;margin-bottom:8px}\n.dm{font-size:13px;padding:3px 0;color:#d8dde8}\n.dm .who{color:var(--accent);font-weight:600}\n.gift{color:#ffd666}\n.rec{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}\n.rec button{background:#232936;border:1px solid #313a4a;color:#cfd6e4;padding:6px 10px;border-radius:14px;font-size:12px;cursor:pointer}\n.rec button:active{background:#2d3648}\n.plain{white-space:pre-wrap;font-size:13px;color:#cfd6e4}\n.err{color:#ff7875;font-size:12px;padding:8px}\n</style>\n</head><body>\n<div class=\"wrap\"><div class=\"phone\" id=\"root\">\n  <div class=\"tabs\" id=\"tabs\"></div>\n  <div id=\"panes\"><div class=\"empty\">手机还没开机…</div></div>\n</div></div>\n<script type=\"application/json\" id=\"phone-src\"><%- JSON.stringify(src).replace(/</g,\"\\u003c\") %></script>\n<script type=\"module\">\n\nconst __injected = (()=>{ try{ const n=document.getElementById('phone-src'); return n? JSON.parse(n.textContent):''; }catch(e){ return ''; } })();\nconst STICKERS = {\"https://i.postimg.cc/FK9yf3BS/猫猫亲亲.jpg\": \"猫猫亲亲\", \"https://i.postimg.cc/kXbFLnS2/小猫抛媚眼.gif\": \"小猫抛媚眼\", \"https://i.postimg.cc/RFhwd99V/猫猫眼巴巴.jpg\": \"猫猫眼巴巴\", \"https://i.postimg.cc/7hDVHSDf/猫猫愣住.jpg\": \"猫猫愣住\", \"https://i.postimg.cc/7LF9RpW1/猫猫加载中.jpg\": \"猫猫加载中\", \"https://i.postimg.cc/fLPmgFT7/猫优雅.gif\": \"猫优雅\", \"https://i.postimg.cc/3w49nKnJ/烦.gif\": \"猫猫-烦\", \"https://i.postimg.cc/N0SCcy5H/泥嚎.jpg\": \"猫泥嚎\", \"https://i.postimg.cc/W1mmbXXj/猫猫乖巧.jpg\": \"猫猫乖巧\", \"https://i.postimg.cc/90Wd5Vt9/羞涩.png\": \"羞涩\", \"https://i.postimg.cc/ZK58wbqt/问号.jpg\": \"猫猫问号\", \"https://i.postimg.cc/c1byJJ2X/image.jpg\": \"啊？\", \"https://i.postimg.cc/XNcL21cF/猫猫窝囊.jpg\": \"猫猫窝囊\", \"https://i.postimg.cc/PxJVGWXh/image.jpg\": \"小猫咪_正经\", \"https://i.postimg.cc/5NWczr9C/image.jpg\": \"我要闹了\", \"https://i.postimg.cc/hPLk10h3/image.jpg\": \"猫猫-我饿\", \"https://i.postimg.cc/2SHX09YT/来啦.jpg\": \"猫猫来啦\", \"https://i.postimg.cc/BZg55L4B/闪亮登场.jpg\": \"闪亮登场\", \"https://i.postimg.cc/HLhRkZPj/指指点点.jpg\": \"指指点点\", \"https://i.postimg.cc/134K3mxc/猫猫抱头.gif\": \"猫猫抱头\", \"https://i.postimg.cc/65W0FVYP/猫猫超人.jpg\": \"猫猫超人\", \"https://i.postimg.cc/vB5hw3JJ/猫猫惊讶.jpg\": \"猫猫惊讶\", \"https://i.postimg.cc/QNp42dsF/点头.gif\": \"猫猫点头\", \"https://i.postimg.cc/5t6KT5NJ/活不了一点.jpg\": \"活不了一点\", \"https://i.postimg.cc/tJ5zY7CD/猫猫打拳.gif\": \"猫猫打拳\", \"https://i.postimg.cc/J4xThYsm/潦草小猫.gif\": \"潦草小猫\", \"https://i.postimg.cc/4d0LXYyc/image.jpg\": \"已红温\", \"https://i.postimg.cc/3RzsnSgz/image.jpg\": \"我就盯到你喜欢我为止\", \"https://i.postimg.cc/q7vHRCJD/image.jpg\": \"想看你洗澡\", \"https://i.postimg.cc/tg58GRFd/image.png\": \"好渴望色色\", \"https://i.postimg.cc/FKmZj277/好耶!.jpg\": \"好耶！\", \"https://i.postimg.cc/rsdCVTYY/小狗落泪.jpg\": \"小狗落泪\", \"https://i.postimg.cc/76tnrhX2/小狗问号.jpg\": \"小狗问号\", \"https://i.postimg.cc/K8sJPK7H/爱你.jpg\": \"爱你\", \"https://i.postimg.cc/bY7PTJgd/image.jpg\": \"开心\", \"https://i.postimg.cc/26qpdRB4/image.jpg\": \"我乖乖的\", \"https://i.postimg.cc/rzXft7SF/image.gif\": \"小狗笑\", \"https://i.postimg.cc/C1484XTx/image.gif\": \"你才是真的狗？\", \"https://i.postimg.cc/7hgWXxPT/暗示色色.png\": \"暗示色色\", \"https://i.postimg.cc/hjmyPSd3/柴犬抽泣.gif\": \"柴犬抽泣\", \"https://i.postimg.cc/9FYk7FN6/望眼欲穿.jpg\": \"柴犬望眼欲穿\", \"https://i.postimg.cc/k4M32R7h/image.gif\": \"兔子嚼嚼嚼\", \"https://i.postimg.cc/sxZnx3GN/image.webp\": \"小兔送玫瑰\", \"https://i.postimg.cc/T2SF645s/image.jpg\": \"小兔叹气\", \"https://i.postimg.cc/MpJLcfDb/image.jpg\": \"小兔惊讶\", \"https://i.postimg.cc/Fz2BVYQv/ok.jpg\": \"小兔ok\", \"https://i.postimg.cc/28ZJ874S/image.jpg\": \"小兔好的\", \"https://i.postimg.cc/mg357Zpx/image.jpg\": \"小兔生气\", \"https://i.postimg.cc/vmQShRC4/image.jpg\": \"小兔紧张\", \"https://i.postimg.cc/ZqVsD7hV/image.jpg\": \"小兔踹萝卜\", \"https://i.postimg.cc/kgWsRnM0/兔兔哇哦.gif\": \"兔兔哇哦\", \"https://i.postimg.cc/TPwBGM0Z/image.jpg\": \"兔兔抱抱\", \"https://i.postimg.cc/7hT0vVfF/路过.gif\": \"兔兔路过\", \"https://i.postimg.cc/FRHV63bv/兔兔飞吻.gif\": \"兔兔飞吻\", \"https://i.postimg.cc/4xRbgrvB/施魔法.gif\": \"施魔法\", \"https://i.postimg.cc/PqVs8rNX/image.png\": \"我也想要\", \"https://i.postimg.cc/vmtw8twV/image.jpg\": \"冒爱心\", \"https://i.postimg.cc/m2vVrc43/对不起.jpg\": \"对不起\", \"https://i.postimg.cc/vmzvX3VX/小狗翻白眼.jpg\": \"小狗翻白眼\", \"https://i.postimg.cc/vT9pjrhT/image.jpg\": \"我很好\", \"https://i.postimg.cc/mDW3j7P8/硬撑.png\": \"小狗硬撑\", \"https://i.postimg.cc/157pTkgg/鼠了.jpg\": \"小狗鼠了\", \"https://i.postimg.cc/bw1KL9JB/image.gif\": \"大成功\", \"https://i.postimg.cc/q7TddZSr/image.gif\": \"冒爱心\", \"https://i.postimg.cc/qqbCPK7f/image.gif\": \"你要让着我\", \"https://i.postimg.cc/kM69K8xk/image.gif\": \"库洛米大哭\", \"https://i.postimg.cc/BZDkJC5Q/最喜欢你啦.gif\": \"最喜欢你啦\", \"https://i.postimg.cc/8PNKNgPt/点赞.gif\": \"点赞\", \"https://i.postimg.cc/NMNhmGMG/image.gif\": \"库洛米哇哦\", \"https://i.postimg.cc/WzKQY9gQ/image.gif\": \"和好卷\", \"https://i.postimg.cc/k59LHRRX/image.gif\": \"好想老公\", \"https://i.postimg.cc/wv5XG3JH/自闭了.jpg\": \"自闭了\", \"https://i.postimg.cc/nLBBXM37/image.gif\": \"你很烦內\", \"https://i.postimg.cc/0jrTfgMY/image.gif\": \"吃嘛嘛香\", \"https://i.postimg.cc/FHZQNx4J/image.gif\": \"怪不好意思\", \"https://i.postimg.cc/9X75r222/image.gif\": \"我听听\", \"https://i.postimg.cc/XYxtT7ff/image.gif\": \"我来咯\", \"https://i.postimg.cc/HkJQC656/顺风顺水.gif\": \"顺风顺水\", \"https://i.postimg.cc/j2r8DG6q/溜了溜了.gif\": \"溜了溜了\", \"https://i.postimg.cc/0jdVDcZY/流汗.gif\": \"流汗\", \"https://i.postimg.cc/HnGNQJmg/星星眼.gif\": \"星星眼\", \"https://i.postimg.cc/28DJyBTd/晚安.gif\": \"晚安\", \"https://i.postimg.cc/0y5BdRTb/来打我呀.gif\": \"来打我呀\", \"https://i.postimg.cc/y8BzMbwH/image.jpg\": \"想我卷\", \"https://i.postimg.cc/MZdRMCms/image.gif\": \"你等着马上干死你\", \"https://i.postimg.cc/K8Y037TT/熊熊喜欢.jpg\": \"熊熊喜欢\", \"https://i.postimg.cc/dVJzHTyQ/抱抱.jpg\": \"抱抱\", \"https://i.postimg.cc/mD4MCRnn/fufu.jpg\": \"你怎么傻fufu的\", \"https://i.postimg.cc/RhXcv8XD/老实点娇喘.png\": \"老实点娇喘\", \"https://i.postimg.cc/cLjBKp0q/疯狂思考.gif\": \"疯狂思考\", \"https://i.postimg.cc/RFJ867jd/握手.gif\": \"握手\", \"https://i.postimg.cc/cLYN2NDT/image.jpg\": \"动心\", \"https://i.postimg.cc/Z516Y6x4/鼓掌.gif\": \"鼓掌\", \"https://i.postimg.cc/s2h95TgM/给钱花.jpg\": \"给钱花\", \"https://i.postimg.cc/fTYNgNqC/image.jpg\": \"心态崩了\", \"https://i.postimg.cc/28ss4KzW/image.jpg\": \"嘻嘻\", \"https://i.postimg.cc/W31CNR7B/image.jpg\": \"威胁杀掉\", \"https://i.postimg.cc/kXTcCVHg/看看腹肌.jpg\": \"看看腹肌\", \"https://i.postimg.cc/BbQK7p4c/image.jpg\": \"傻逼\", \"https://i.postimg.cc/RVJrJBz9/image.jpg\": \"好害怕\", \"https://i.postimg.cc/WzDyZMCS/image.jpg\": \"害羞\", \"https://i.postimg.cc/QtYPV64H/image.gif\": \"宝宝今晚可以吗\", \"https://i.postimg.cc/L473yqJd/牛啤.jpg\": \"牛啤\"};\nconst el = (t, c, txt) => { const n = document.createElement(t); if (c) n.className = c; if (txt != null) n.textContent = txt; return n; };\n\nfunction ini(name){\n  if(!name) return '?';\n  return name.trim().slice(0,1);\n}\nfunction avatar(name, url){\n  const d = el('div','ava');\n  if(url){ const i = el('img'); i.src = url; i.onerror = ()=>{ d.textContent = ini(name); }; d.appendChild(i); }\n  else d.textContent = ini(name);\n  return d;\n}\n\n/* ---------- 解析 ---------- */\nfunction parsePhone(text){\n  const chat = [];      // 私聊与群聊\n  const moments = [];   // 朋友圈\n  const lives = [];     // 直播\n  const friends = [];\n  let seq = 0;\n\n  const lines = text.split(/\\r?\\n/);\n  let cur = null;       // 当前聊天窗口\n  for(const raw of lines){\n    const line = raw.trim();\n    if(!line) continue;\n\n    // [和X的聊天]\n    let m = /^\\[和(.+?)的聊天\\]$/.exec(line);\n    if(m){\n      const title = m[1];\n      const exist = chat.find(c=>c.title===title);\n      if(exist){ cur = exist; }\n      else { cur = {id:'c'+(seq++), title, kind:'chat', items:[]}; chat.push(cur); }\n      continue;\n    }\n    // [对方消息|名字|id|类型|内容]\n    m = /^\\[对方消息\\|([^|\\]]*)\\|([^|\\]]*)\\|([^|\\]]*)\\|(.*)\\]$/s.exec(line);\n    if(m){\n      if(!cur){ cur = {id:'c'+(seq++), title:'私聊', kind:'chat', items:[]}; chat.push(cur); }\n      cur.items.push({name:m[1], uid:m[2], type:m[3]||'文字', body:m[4]});\n      continue;\n    }\n    // [群聊消息|群id|名字|类型|内容]\n    m = /^\\[群聊消息\\|([^|\\]]*)\\|([^|\\]]*)\\|([^|\\]]*)\\|(.*)\\]$/s.exec(line);\n    if(m){\n      if(!cur){ cur = {id:'c'+(seq++), title:'群聊', kind:'chat', items:[]}; chat.push(cur); }\n      cur.items.push({gid:m[1], name:m[2], uid:m[1], type:m[3]||'文字', body:m[4]});\n      continue;\n    }\n    // [好友id|名字|数字ID]\n    m = /^\\[好友id\\|([^|\\]]*)\\|([^|\\]]*)\\]$/.exec(line);\n    if(m){ friends.push({name:m[1], uid:m[2]}); continue; }\n    // [群聊|名字|id|成员]\n    m = /^\\[群聊\\|([^|\\]]*)\\|([^|\\]]*)\\|(.*)\\]$/.exec(line);\n    if(m){ friends.push({name:m[1], uid:m[2], members:m[3]}); continue; }\n    // [朋友圈|名字|id|楼层|内容]\n    m = /^\\[朋友圈\\|([^|\\]]*)\\|([^|\\]]*)\\|([^|\\]]*)\\|(.*)\\]$/s.exec(line);\n    if(m){ moments.push({name:m[1], uid:m[2], lid:m[3], body:m[4], replies:[]}); continue; }\n    // [朋友圈回复|名字|id|楼层|内容]\n    m = /^\\[朋友圈回复\\|([^|\\]]*)\\|([^|\\]]*)\\|([^|\\]]*)\\|(.*)\\]$/s.exec(line);\n    if(m){\n      const t = moments.find(x=>x.lid===m[3]) || moments[moments.length-1];\n      if(t) t.replies.push({name:m[1], body:m[4]});\n      continue;\n    }\n    // [直播|...]\n    m = /^\\[直播\\|([^|\\]]*)\\|([^|\\]]*)\\|(.*)\\]$/s.exec(line);\n    if(m){\n      let L = lives[lives.length-1];\n      if(!L){ L = {id:'l'+(seq++), num:'', content:'', dm:[], gifts:[], rec:[]}; lives.push(L); }\n      const a=m[1], b=m[2], c=(m[3]||'').trim();\n      if(a==='本场人数') L.num = b||c;\n      else if(a==='直播内容'){ L.content = b || c; }\n      else if(a==='推荐互动'){ L.rec.push(b||c); }\n      else if(b==='弹幕'){ L.dm.push({who:a, text:c}); }\n      else if(b==='打赏'){ L.gifts.push({who:a, text:c}); }\n      else { L.dm.push({who:a, text:(b+' '+c).trim()}); }\n      continue;\n    }\n  }\n  return {chat, moments, lives, friends};\n}\n\n/* ---------- 渲染 ---------- */\nfunction renderChat(c){\n  const f = el('div','pane');\n  const head = el('div','head');\n  head.appendChild(el('span',null,c.title));\n  head.appendChild(el('span',null,c.items.length+' 条'));\n  f.appendChild(head);\n  for(const it of c.items){\n    const row = el('div','msg');\n    row.appendChild(avatar(it.name));\n    const b = el('div','body');\n    b.appendChild(el('div','name', it.gid ? (it.name+' · 群'+it.gid) : (it.name+' · '+(it.uid||''))));\n    const t = it.type;\n    if(t==='表情包'){\n      const img = el('img','sticker');\n      img.src = it.body.trim();\n      img.alt = STICKERS[img.src] || '表情';\n      img.onerror = ()=>{ const s=el('div','bubble','[表情加载失败]'); img.replaceWith(s); };\n      b.appendChild(img);\n    } else if(t==='红包'){\n      const r = el('div','redenv');\n      r.appendChild(el('span',null,'🧧 红包'));\n      r.appendChild(el('small',null,'¥'+it.body));\n      b.appendChild(r);\n    } else if(t==='语音'){\n      const v = el('div','bubble voice');\n      v.appendChild(el('span',null,'🔊'));\n      const vp = String(it.body).split('|');\n      const vtxt = vp[0] || '';\n      const vdur = (vp[1]||'').replace(/[^0-9]/g,'');\n      v.appendChild(el('span',null,vtxt));\n      v.appendChild(el('span','dur',(vdur?vdur:Math.max(1,Math.round(vtxt.length/6)))+\"''\"));\n      b.appendChild(v);\n    } else {\n      b.appendChild(el('div','bubble', it.body));\n    }\n    row.appendChild(b);\n    f.appendChild(row);\n  }\n  return f;\n}\n\nfunction renderMoment(m){\n  const d = el('div','moment');\n  const h = el('div','mhead');\n  h.appendChild(avatar(m.name));\n  const hb = el('div'); hb.appendChild(el('div','name',m.name)); hb.appendChild(el('div','meta','ID '+m.uid));\n  h.appendChild(hb);\n  d.appendChild(h);\n  d.appendChild(el('div','mtext', m.body));\n  d.appendChild(el('div','mmeta','#'+m.lid));\n  if(m.replies.length){\n    const rp = el('div','replies');\n    for(const r of m.replies){\n      const line = el('div','reply');\n      const b = el('b',null,r.name+'：');\n      line.appendChild(b); line.appendChild(document.createTextNode(r.body));\n      rp.appendChild(line);\n    }\n    d.appendChild(rp);\n  }\n  return d;\n}\n\nfunction renderLive(L){\n  const d = el('div','livebox');\n  d.appendChild(el('div','livenum','👁 在線 '+(L.num||'--')));\n  if(L.content) d.appendChild(el('div','plain',L.content));\n  if(L.dm.length){\n    const box = el('div'); box.style.marginTop='10px';\n    for(const x of L.dm){\n      const p = el('div','dm');\n      p.appendChild(el('span','who',x.who+'：'));\n      p.appendChild(document.createTextNode(x.text));\n      box.appendChild(p);\n    }\n    d.appendChild(box);\n  }\n  if(L.gifts.length){\n    const box = el('div'); box.style.marginTop='8px';\n    for(const x of L.gifts){\n      const p = el('div','dm gift');\n      p.appendChild(el('span','who',x.who+' 打赏 '));\n      p.appendChild(document.createTextNode(x.text));\n      box.appendChild(p);\n    }\n    d.appendChild(box);\n  }\n  if(L.rec.length){\n    const r = el('div','rec');\n    for(const t of L.rec){\n      const btn = el('button',null,t);\n      btn.onclick = ()=>{ post(t); };\n      r.appendChild(btn);\n    }\n    d.appendChild(r);\n  }\n  return d;\n}\n\nasync function post(text){\n  try{\n    const api = await window.ElecKoiReady;\n    const ctx = await api.context.current();\n    const input = api.input;\n    const cur = input.get ? await input.get() : '';\n    await input.set((cur ? cur+'\\n' : '') + text);\n  }catch(e){ /* 静默 */ }\n}\n\nfunction build(data){\n  const tabs = document.getElementById('tabs');\n  const panes = document.getElementById('panes');\n  tabs.innerHTML=''; panes.innerHTML='';\n  const all = [];\n  for(const c of data.chat) all.push({label:c.title, kind:'chat', data:c});\n  if(data.moments.length) all.push({label:'朋友圈', kind:'moment', data:data.moments});\n  if(data.lives.length) all.push({label:'直播', kind:'live', data:data.lives});\n  if(!all.length){ panes.innerHTML=''; panes.appendChild(el('div','empty','手机里暂时没有动静')); return; }\n\n  all.forEach((t,i)=>{\n    const tab = el('div','tab'+(i===0?' on':''), t.label);\n    tab.onclick = ()=>{\n      [...tabs.children].forEach(c=>c.classList.remove('on'));\n      [...panes.children].forEach(c=>c.classList.remove('on'));\n      tab.classList.add('on');\n      panes.children[i].classList.add('on');\n    };\n    tabs.appendChild(tab);\n    const p = el('div','pane'+(i===0?' on':''));\n    if(t.kind==='chat') p.appendChild(renderChat(t.data));\n    else if(t.kind==='moment'){ for(const m of t.data) p.appendChild(renderMoment(m)); }\n    else { for(const L of t.data) p.appendChild(renderLive(L)); }\n    panes.appendChild(p);\n  });\n}\n\n/* ---------- 启动 ---------- */\n(async ()=>{\n  const tabs = document.getElementById('tabs');\n  const panes = document.getElementById('panes');\n  try{\n    const api = await window.ElecKoiReady;\n    const ctx = await api.context.current();\n    let src = __injected || '';\n    if(ctx && ctx.messageId){\n      const msg = await api.messages.get(ctx.messageId);\n      src = (msg && (msg.content || msg.displayContent)) || '';\n    }\n    if(!src){\n      // 退回：直接读当前 DOM 里的 <Phone> 块\n      const host = document.querySelector('[data-eleckoi-content]') || document.body;\n      src = host.textContent || '';\n    }\n    const m = /<Phone>([\\s\\S]*?)<\\/Phone>/i.exec(src);\n    const inner = m ? m[1] : src;\n    const data = parsePhone(inner);\n    build(data);\n  }catch(e){\n    // 没有 SDK 时也尽量渲染：解析本页可见文本\n    try{\n      const m = /<Phone>([\\s\\S]*?)<\\/Phone>/i.exec(document.body.textContent||'');\n      if(m){ build(parsePhone(m[1])); }\n      else { panes.innerHTML=''; const d=el('div','err'); d.textContent='手机数据读取失败：'+e.message; panes.appendChild(d); }\n    }catch(e2){\n      panes.innerHTML='';\n      const d=el('div','err'); d.textContent='手机数据读取失败'; panes.appendChild(d);\n    }\n  }\n})();\n</script>\n</body></html>\n",
